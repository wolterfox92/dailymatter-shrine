    "pillars": {
      "type": "custom-bc-pillars",
      "blocks": {
        "pillar-1": {
          "type": "pillar",
          "settings": {
            "eyebrow": "Daily energy",
            "title": "Less tired",
            "text": "<p>Magnesium en de vitamines B5, B6 en B12 helpen vermoeidheid en moeheid te verminderen.</p>"
          }
        },
        "pillar-2": {
          "type": "pillar",
          "settings": {
            "eyebrow": "Mental performance",
            "title": "Stay with it",
            "text": "<p>Vitamine B5 draagt bij aan normale mentale prestaties.</p>"
          }
        },
        "pillar-3": {
          "type": "pillar",
          "settings": {
            "eyebrow": "Physical performance",
            "title": "When it gets intense",
            "text": "<p>Creatine verhoogt de fysieke prestaties bij opeenvolgende reeksen korte, intensieve oefeningen.**</p>"
          }
        }
      },
      "block_order": ["pillar-1", "pillar-2", "pillar-3"],
      "settings": {}
    },
    "ingredients": {
      "type": "custom-bc-ingredients",
      "blocks": {
        "ing-1": {
          "type": "ingredient",
          "settings": {
            "icon": "fitness_center",
            "name": "Creatine",
            "meta": "For intense efforts · [3 of 5 g] per sachet",
            "text": "<p>Creatine helpt fysieke prestaties te verhogen bij herhaalde, korte en intensieve inspanningen.** Het werkt niet als een directe stimulant: het effect komt door dagelijks gebruik.</p>"
          }
        },
        "ing-2": {
          "type": "ingredient",
          "settings": {
            "icon": "spa",
            "name": "Magnesium",
            "meta": "For energy and less fatigue · [·· mg]",
            "text": "<p>Magnesium ondersteunt een normale energiehuishouding en helpt vermoeidheid te verminderen. Het draagt daarnaast bij aan het normaal functioneren van het zenuwstelsel en aan een normale psychologische functie.</p>"
          }
        },
        "ing-3": {
          "type": "ingredient",
          "settings": {
            "icon": "psychology",
            "name": "Vitamine B5",
            "meta": "For mental performance · [·· mg · ··% RI]",
            "text": "<p>Vitamine B5 draagt bij aan normale mentale prestaties, ondersteunt de energiehuishouding en helpt vermoeidheid te verminderen.</p>"
          }
        },
        "ing-4": {
          "type": "ingredient",
          "settings": {
            "icon": "bolt",
            "name": "Vitamine B6 + B12",
            "meta": "For everyday energy · [·· µg · ··% RI]",
            "text": "<p>Vitamine B6 en B12 ondersteunen de normale energiehuishouding en helpen vermoeidheid te verminderen.</p>"
          }
        },
        "ing-5": {
          "type": "ingredient",
          "settings": {
            "icon": "brightness_5",
            "name": "Vitamine C",
            "meta": "For everyday support · [·· mg · ··% RI]",
            "text": "<p>Vitamine C ondersteunt een normale energiehuishouding, draagt bij aan de normale werking van het immuunsysteem en helpt vermoeidheid te verminderen.</p>"
          }
        },
        "ing-6": {
          "type": "ingredient",
          "settings": {
            "icon": "grain",
            "name": "Sodium + potassium",
            "meta": "Electrolytes included · [·· mg]",
            "text": "<p>Iedere sachet bevat natrium en kalium: twee bekende elektrolyten.</p>"
          }
        }
      },
      "block_order": ["ing-1", "ing-2", "ing-3", "ing-4", "ing-5", "ing-6"],
      "settings": {}
    },
