    "faq": {
      "type": "custom-bc-faq",
      "blocks": {
        "q-1": {
          "type": "question",
          "settings": {
            "question": "What is Energy Foundation?",
            "answer": "<p>Een dagelijkse drinkmix met creatine, elektrolyten, magnesium en B-vitaminen. Eén sachet meng je met koud water.</p>"
          }
        },
        "q-2": {
          "type": "question",
          "settings": {
            "question": "Does it contain caffeine?",
            "answer": "<p>Nee. Energy Foundation is cafeïnevrij.</p>"
          }
        },
        "q-3": {
          "type": "question",
          "settings": {
            "question": "When should I take it?",
            "answer": "<p>Kies vooral een moment dat je makkelijk iedere dag kunt herhalen. Bijvoorbeeld in de ochtend, tijdens je werkdag of rond je training.</p>"
          }
        },
        "q-4": {
          "type": "question",
          "settings": {
            "question": "Do I need to exercise to use it?",
            "answer": "<p>Energy Foundation is ontwikkeld voor actieve, volle dagen. De specifieke toegestane creatineclaim is gericht op volwassenen die intensieve inspanning leveren.</p>"
          }
        },
        "q-5": {
          "type": "question",
          "settings": {
            "question": "How does Black Cherry taste?",
            "answer": "<p>Fruitig, vol en licht fris, zonder overdreven zoet te worden.</p>"
          }
        },
        "q-6": {
          "type": "question",
          "settings": {
            "question": "How much water should I use?",
            "answer": "<p>Meng één sachet met ongeveer 500 ml koud water. Wie een sterkere smaak wil, kan iets minder water gebruiken.</p>"
          }
        },
        "q-7": {
          "type": "question",
          "settings": {
            "question": "When will it launch?",
            "answer": "<p>We bereiden momenteel de eerste batch voor. Leden van de first-drop-lijst krijgen als eerste de definitieve lanceringsdatum.</p>"
          }
        },
        "q-8": {
          "type": "question",
          "settings": {
            "question": "Am I placing an order?",
            "answer": "<p>Nee. Aanmelden voor de first drop is vrijblijvend en is nog geen bestelling.</p>"
          }
        }
      },
      "block_order": ["q-1", "q-2", "q-3", "q-4", "q-5", "q-6", "q-7", "q-8"],
      "settings": {}
