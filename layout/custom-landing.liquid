{%- comment -%}
  Bare layout for advertising landing pages.

  Referenced from a JSON template via its "layout" property, e.g.
  templates/page.waitinglist.json -> "layout": "custom-landing".

  This is a NEW file, not a modification of Shrine's layout/theme.liquid, so a
  Shrine update cannot overwrite it. It deliberately omits the header-group and
  footer-group section groups: a waitlist landing page has one job, and store
  navigation only leaks the traffic you paid for. The page brings its own header,
  footer and CTA bar as sections.

  Because this is still a JSON template, everything stays editable and reorderable
  in the theme editor.
{%- endcomment -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- comment -%}
      Loaded here rather than via the Clarity app embed, which is enabled but emits
      nothing. See snippets/custom-clarity.liquid and docs/sections.md#microsoft-clarity.
    {%- endcomment -%}
    {% render 'custom-clarity', project_id: 'y0trvvheh2' %}

    {%- comment -%}
      Every Clarity call for this page sits in this one file, next to the tag it
      talks to. Delete both lines and the measurement layer is gone, with no
      leftovers in the sections. Taxonomy: docs/sections.md#microsoft-clarity.
    {%- endcomment -%}
    <script src="{{ 'custom-bc-clarity.js' | asset_url }}" defer></script>

    {{ 'custom-bc.css' | asset_url | stylesheet_tag }}
    {% section 'custom-bc-page-style' %}

    {% style %}
      /* Shrine's base.css is deliberately not loaded here, and with it goes the
         global border-box reset every rule in custom-bc.css assumes. Without
         this, width:100% plus padding overflows and the page scrolls sideways. */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: #ffffff;
        /* Belt and braces: nothing on a landing page may scroll sideways. */
        overflow-x: hidden;
      }

      /* This layout does not load Shrine's base.css, so the skip link needs its
         own visually-hidden treatment rather than borrowing those classes. */
      .bc-skip {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 60;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        padding: 12px 18px;
        background: #180223;
        color: #f8f8ed;
        font: 700 14px/1.2 system-ui, sans-serif;
        text-decoration: none;
      }

      .bc-skip:focus {
        width: auto;
        height: auto;
        clip-path: none;
        margin: 8px;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }
      }
    {% endstyle %}
  </head>

  <body class="bc-body-root">
    <a class="bc-skip" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
