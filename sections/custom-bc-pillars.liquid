{%- comment -%}
  Black Cherry waitlist — section 5 "Drie pijlers".
  Raised cards, each an image plus eyebrow / title / claim text.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign pillar_count = 0
  for block in section.blocks
    if block.type == 'pillar'
      assign pillar_count = pillar_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-pillars {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7.6vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-pillar__eyebrow {
    color: {{ s.card_eyebrow_color }};
  }
{%- endstyle -%}

<section class="bc-pillars">
  <div class="bc-inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if pillar_count > 0 -%}
      <ul class="bc-cards" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'pillar' -%}
            {%- liquid
              assign img = block.settings.image
              assign img_alt = img.alt | default: block.settings.title | strip_html | escape
            -%}
            <li class="bc-card bc-card--raised bc-pillar" {{ block.shopify_attributes }}>
              <div class="bc-media bc-card__media">
                {%- if img != blank -%}
                  {{-
                    img
                    | image_url: width: 1040
                    | image_tag:
                      width: img.width,
                      height: img.height,
                      alt: img_alt,
                      sizes: '(min-width: 1264px) 346px, (min-width: 950px) 29vw, (min-width: 552px) 520px, 100vw',
                      widths: '350, 390, 520, 700, 780, 1040',
                      loading: 'lazy',
                      decoding: 'async'
                  -}}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="bc-card__body">
                {%- if block.settings.eyebrow != blank -%}
                  <p class="bc-pillar__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.title != blank -%}
                  <h3 class="bc-pillar__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="bc-pillar__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BC · Pijlers",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it matters"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for more than one moment."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "min": 20,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Heading minimum",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "min": 26,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading maximum",
      "default": 38
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrond",
      "default": "#f8f8ed"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#634c61"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#180223"
    },
    {
      "type": "color",
      "id": "card_eyebrow_color",
      "label": "Eyebrow op de kaarten",
      "default": "#634c61"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pijler",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Daily energy"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Less tired"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Tekst",
          "default": "<p>Magnesium en de vitamines B5, B6 en B12 helpen vermoeidheid en moeheid te verminderen.</p>"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "BC · Pijlers",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "eyebrow": "Daily energy",
            "title": "Less tired",
            "text": "<p>Magnesium en de vitamines B5, B6 en B12 helpen vermoeidheid en moeheid te verminderen.</p>"
          }
        },
        {
          "type": "pillar",
          "settings": {
            "eyebrow": "Mental performance",
            "title": "Stay with it",
            "text": "<p>Vitamine B5 draagt bij aan normale mentale prestaties.</p>"
          }
        },
        {
          "type": "pillar",
