{%- comment -%}
  Black Cherry waitlist — section 1 "Hero".

  The design offered an A/B switch on the headline (routine vs product). That is
  a copy decision, so the headline is simply a setting: duplicate the template or
  swap the text to run the test.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign image = s.image
  assign image_alt = image.alt | default: s.heading | strip_html | escape

  assign chip_count = 0
  for block in section.blocks
    if block.type == 'chip'
      assign chip_count = chip_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-hero {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-chip-icon: {{ s.chip_icon_color }};
    --bc-h1-size: clamp({{ s.heading_size_min }}px, 10.4vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-hero__media {
    --bc-media-bg: {{ s.media_bg_color }};
  }
{%- endstyle -%}

<section class="bc-hero">
  <div class="bc-hero__inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h1 class="bc-h1">{{ s.heading | escape }}</h1>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="bc-body">{{ s.body }}</div>
    {%- endif -%}

    {%- if s.cta_label != blank -%}
      <div class="bc-hero__cta">
        <a class="bc-btn bc-btn--primary bc-btn--full" href="{{ s.cta_link | default: '#bc-signup' }}">
          {{- s.cta_label | escape -}}
          {% render 'custom-bc-icon', icon: 'arrow_downward', size: 22 %}
        </a>
      </div>
    {%- endif -%}

    {%- if s.note != blank -%}
      <div class="bc-hero__note">{{ s.note }}</div>
    {%- endif -%}

    {%- if s.link_label != blank -%}
      <div class="bc-hero__link">
        <a href="{{ s.link_url | default: '#bc-ingredients' }}">{{ s.link_label | escape }}</a>
      </div>
    {%- endif -%}

    {%- if chip_count > 0 -%}
      <ul class="bc-chips" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'chip' and block.settings.text != blank -%}
            <li class="bc-chip" {{ block.shopify_attributes }}>
              {% render 'custom-bc-icon', icon: block.settings.icon, size: 15 %}
              {{ block.settings.text | escape }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="bc-media bc-hero__media">
      {%- if image != blank -%}
        {{-
          image
          | image_url: width: 1040
          | image_tag:
            width: image.width,
            height: image.height,
            alt: image_alt,
            sizes: '(min-width: 552px) 520px, 100vw',
            widths: '390, 520, 780, 1040',
            loading: 'eager',
            decoding: 'async'
        -}}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}

      {%- if s.media_tag != blank -%}
        <span class="bc-media__tag">{{ s.media_tag | escape }}</span>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BC · Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Energy Foundation · Black Cherry"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What you do daily, matters."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px",
      "label": "Heading minimum",
      "default": 38
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Heading maximum",
      "default": 50
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Tekst",
      "default": "<p>Eén dagelijkse mix met creatine, elektrolyten, magnesium en B-vitaminen. Gemaakt voor volle dagen, actieve plannen en een routine die je wél volhoudt. Zonder cafeïne en zonder toegevoegde suikers.*</p>"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Knoptekst",
      "default": "Join the first drop"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Knoplink",
      "default": "#bc-signup"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "Tekst onder de knop",
      "default": "<p>Als eerste toegang + <strong>25% korting</strong> op je order + een <strong>gratis waterfles</strong> t.w.v. € 17,95.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Tekstlink",
      "default": "Discover what's inside"
    },
    {
      "type": "text",
      "id": "link_url",
      "label": "Tekstlink URL",
      "default": "#bc-ingredients"
    },
    {
      "type": "header",
      "content": "Afbeelding"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero-afbeelding",
      "info": "Vierkant. Ontwerpbriefing: verpakking + sachet + fles met dieprode liquid, condens, enkele donkere kersen."
    },
    {
      "type": "text",
      "id": "media_tag",
      "label": "Label op de afbeelding",
      "default": "First flavour · Black Cherry"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrond",
      "default": "#fee7e7"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#882e49"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#180223"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Tekst",
      "default": "#523b54"
    },
    {
      "type": "color",
      "id": "chip_icon_color",
      "label": "Chip-icoon",
      "default": "#882e49"
    },
    {
      "type": "color",
      "id": "media_bg_color",
      "label": "Achtergrond afbeelding",
      "default": "#511a39"
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Chip",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "local_cafe", "label": "Kopje" },
            { "value": "calendar_month", "label": "Kalender" },
            { "value": "local_florist", "label": "Bloem" },
            { "value": "water_drop", "label": "Druppel" },
            { "value": "bolt", "label": "Bliksem" },
            { "value": "check", "label": "Vinkje" },
            { "value": "spa", "label": "Blad" },
            { "value": "grain", "label": "Korrels" },
            { "value": "fitness_center", "label": "Halter" },
            { "value": "brightness_5", "label": "Zon" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Caffeine-free"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "BC · Hero",
      "blocks": [
        { "type": "chip", "settings": { "icon": "local_cafe", "text": "Caffeine-free" } },
        { "type": "chip", "settings": { "icon": "calendar_month", "text": "30 daily sachets" } },
        { "type": "chip", "settings": { "icon": "local_florist", "text": "Black Cherry" } },
        { "type": "chip", "settings": { "icon": "water_drop", "text": "Mix with cold water" } }
      ]
    }
  ]
}
{% endschema %}
