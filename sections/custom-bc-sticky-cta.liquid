{%- comment -%}
  Black Cherry waitlist — sticky CTA bar.

  Appears once the visitor has scrolled past the hero and hides again while the
  signup form itself is on screen, so the bar never covers the thing it points at.
  Driven by IntersectionObserver rather than a scroll handler: no work on the
  main thread between intersections.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
-%}

{%- if s.cta_label != blank -%}
  <bc-sticky-cta
    class="bc-sticky"
    data-target="{{ s.cta_link | default: '#bc-signup' }}"
    data-after="{{ s.after_selector | escape }}"
  >
    <div class="bc-sticky__inner">
      {%- comment -%}
        Desktop only (hidden below 950px in custom-bc.css): on a phone the bar is
        one full-width button and a second line would eat viewport it is already
        borrowing. On a wide screen a bare button in an empty bar reads as an
        orphaned control, so it gets its offer back.
      {%- endcomment -%}
      {%- if s.title != blank or s.subtitle != blank -%}
        <div class="bc-sticky__copy">
          {%- if s.title != blank -%}
            <span class="bc-sticky__title">{{ s.title | escape }}</span>
          {%- endif -%}
          {%- if s.subtitle != blank -%}
            <span class="bc-sticky__sub">{{ s.subtitle | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      <a class="bc-btn bc-btn--primary bc-btn--full" href="{{ s.cta_link | default: '#bc-signup' }}">
        {{- s.cta_label | escape -}}
        {% render 'custom-bc-icon', icon: 'arrow_downward', size: 22 %}
      </a>
    </div>
  </bc-sticky-cta>

  <script src="{{ 'custom-bc-sticky.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "BC · Sticky CTA",
  "settings": [
    {
      "type": "text",
      "id": "cta_label",
      "label": "Knoptekst",
      "default": "Join the first drop"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Knoplink",
      "info": "Verwijst naar het aanmeldformulier. De balk verbergt zichzelf zolang dat formulier in beeld is.",
      "default": "#bc-signup"
    },
    {
      "type": "text",
      "id": "after_selector",
      "label": "Verschijnt na",
      "info": "CSS-selector van het element waar de balk na verschijnt. Standaard de hero.",
      "default": ".bc-hero"
    },
    {
      "type": "header",
      "content": "Tekst naast de knop"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "info": "Alleen zichtbaar op desktop. Op mobiel is de balk één knop breed.",
      "default": "Energy Matters — first drop"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Ondertitel",
      "default": "25% korting + gratis waterfles t.w.v. € 17,95"
    }
  ],
  "presets": [{ "name": "BC · Sticky CTA" }]
}
{% endschema %}
