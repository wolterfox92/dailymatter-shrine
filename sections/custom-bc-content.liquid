{%- comment -%}
  Black Cherry waitlist — vrije tekst- en beeldsectie.

  Alle inhoud zit in blokken, niets in vaste sectie-instellingen, zodat de
  volgorde in de editor de volgorde op de pagina is. De opmaak per blok komt
  uit snippets/custom-bc-content-block.liquid, zodat andere BC-secties later
  dezelfde blokkenset kunnen aanbieden.

  Twee kolommen op desktop werkt met dezelfde .bc-split primitive als de andere
  secties: de wrappers zijn op mobiel display:contents, dus daar staat alles
  gewoon onder elkaar — eerst de linker-, dan de rechterblokken. Staat één van
  beide kolommen leeg, dan valt de sectie terug op één doorlopende kolom in
  plaats van een halfbezet raster.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign left_count = 0
  assign right_count = 0
  for block in section.blocks
    if block.settings.column == 'right'
      assign right_count = right_count | plus: 1
    else
      assign left_count = left_count | plus: 1
    endif
  endfor

  assign is_split = false
  if s.layout == 'split' and left_count > 0 and right_count > 0
    assign is_split = true
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-content {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-lead-color: {{ s.lead_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7.6vw, {{ s.heading_size_max }}px);
  }
{%- endstyle -%}

<section class="bc-content bc-content--{% if is_split %}split{% else %}single{% endif %}">
  {%- if is_split -%}
    <div class="bc-inner bc-split{% if s.split_align == 'start' %} bc-split--top{% endif %}">
      <div class="bc-split__body bc-content__col">
        {%- for block in section.blocks -%}
          {%- unless block.settings.column == 'right' -%}
            {%- if block.type == '@app' -%}
              {% render block %}
            {%- else -%}
              {% render 'custom-bc-content-block', block: block, context: 'column' %}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>

      <div class="bc-split__aside bc-content__col">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'right' -%}
            {% render 'custom-bc-content-block', block: block, context: 'column' %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="bc-inner bc-content__col">
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          {% render block %}
        {%- else -%}
          {% render 'custom-bc-content-block', block: block %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

