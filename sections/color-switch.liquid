{%- comment -%}
  Layout-independent by design. This section also runs on templates that use
  layout/custom-landing.liquid, which deliberately loads neither Shrine's
  base.css nor the :root token block from layout/theme.liquid. Three
  consequences, each handled below:

  1. No `html { font-size: 62.5% }`, so 1rem is 16px there instead of 10px.
     Every length in this section is therefore px, never rem.
  2. --font-heading-family / --font-heading-weight are undefined. The --cs-font-*
     tokens below chain through the landing page's own tokens to `inherit`.
  3. The .h0/.h1/.hxl heading classes and .page-width live in base.css. Fallbacks
     for both are wrapped in :where() so they carry zero specificity and lose to
     the real thing wherever base.css *is* loaded.
{%- endcomment -%}

{%- liquid
  # Fallback heading size for layouts without base.css, expressed the way the
  # waitlist sections express theirs (assets/custom-bc.css). 'h0' is literally
  # .bc-h2's clamp, so the default lands on the same size as its neighbours
  # there; the other steps scale around it along base.css's own ratios.
  case section.settings.heading_size
    when 'h3'
      assign heading_fallback = 'clamp(17px, 4.5vw, 18px)'
    when 'h2'
      assign heading_fallback = 'clamp(20px, 5.3vw, 24px)'
    when 'h1'
      assign heading_fallback = 'clamp(23px, 6.1vw, 30px)'
    when 'hxl'
      assign heading_fallback = 'clamp(40px, 10.5vw, 55px)'
    else
      assign heading_fallback = 'clamp(28px, 7.6vw, 38px)'
  endcase

  # A left-aligned header keeps its measure but hugs the left edge; a centred one
  # is centred as a block as well as in its text.
  assign subs_margin = '0 auto'
  if section.settings.content_alignment == 'center'
    assign subs_margin = 'auto'
  endif
-%}

{%- style -%}
  .color-switch-{{ section.id }} {
    --cs-radius: {{ section.settings.image_radius }}px;
    --cs-btn-radius: {{ section.settings.button_radius }}px;
    --cs-gap: {{ section.settings.button_gap }}px;
    --cs-active-bg: {{ section.settings.button_active_background }};
    --cs-active-text: {{ section.settings.button_active_text }};
    --cs-inactive-text: {{ section.settings.button_inactive_text }};
    --cs-inactive-border: {{ section.settings.button_inactive_border }};
    --cs-align: {{ section.settings.content_alignment }};
    --cs-subs-margin: {{ subs_margin }};
    --cs-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --cs-eyebrow-color: {{ section.settings.eyebrow_color }};

    /* Theme token first, then the landing page's own display font, then plain
       inheritance. Nothing here may assume theme.liquid ran. */
    --cs-font-heading: var(--font-heading-family, var(--bc-font-display, inherit));
    --cs-font-heading-weight: var(--font-heading-weight, 800);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- if section.settings.heading_size == 'custom' -%}
    .color-switch-{{ section.id }} .color-switch__heading {
      font-size: {{ section.settings.heading_custom_mobile_size }}px;
    }

    @media screen and (min-width: 750px) {
      .color-switch-{{ section.id }} .color-switch__heading {
        font-size: {{ section.settings.heading_custom_desktop_size }}px;
      }
    }
  {%- else -%}
    :where(.color-switch-{{ section.id }} .color-switch__heading) {
      font-size: {{ heading_fallback }};
    }
  {%- endif -%}
{%- endstyle -%}

<style>
  /* Stand-in for .page-width, which lives in base.css. Zero specificity, so the
     real .page-width still wins on templates that load it. */
  :where(.color-switch__wrap) {
    max-width: var(--page-width, 1400px);
    margin-inline: auto;
    /* --bc-gutter lines the section up with the waitlist sections above and
       below it; 15px is what .page-width would have given anywhere else. */
    padding-inline: var(--bc-gutter, 15px);
  }

  .color-switch {
    margin: 0 auto;
    max-width: {{ section.settings.max_width }}px;
  }

  /* Eyebrow + heading as one block, mirroring .bc-eyebrow / .bc-h2 on the
     waitlist template so the section sits in line with its neighbours. */
  .color-switch__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 8px;
    text-align: var(--cs-align);
  }

  .color-switch__eyebrow {
    margin: 0;
    font-size: var(--cs-eyebrow-size);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cs-eyebrow-color);
  }

  .color-switch__heading {
    margin: 0;
    font-family: var(--cs-font-heading);
    font-weight: var(--cs-font-heading-weight);
    color: {{ section.settings.heading_color }};
  }

  /* base.css gives .h0/.h1/… their line-height and letter-spacing from theme
     tokens; these only apply where that rule is absent. */
  :where(.color-switch__heading) {
    line-height: 0.98;
    letter-spacing: -0.02em;
  }

  .color-switch__subs {
    margin-inline: var(--cs-subs-margin);
    margin-bottom: 24px;
    max-width: 360px;
  }

  .color-switch__subheading {
    text-align: var(--cs-align);
    margin: 0;
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: {{ section.settings.heading_color | color_modify: 'alpha', 0.8 }};
  }

  /* Only the subheading for the selected option is shown. */
  .color-switch__subheading:not(.is-active) {
    display: none;
  }

  /* Stacked, full-width buttons */
  .color-switch__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--cs-gap);
    margin-bottom: 24px;
  }

  .color-switch__btn {
    appearance: none;
    cursor: pointer;
    width: 100%;
    min-height: 40px;
    padding: 10px 16px;
    border: 1px solid var(--cs-inactive-border);
    border-radius: var(--cs-btn-radius);
    background: transparent;
    color: var(--cs-inactive-text);
    font-family: var(--cs-font-heading);
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-align: center;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.15s ease;
  }

  .color-switch__btn:hover {
    border-color: {{ section.settings.button_inactive_text | color_modify: 'alpha', 0.45 }};
  }

  .color-switch__btn:active {
    transform: scale(0.99);
  }

  /* Active state: only the selected button gets the accent color. */
  .color-switch__btn.is-active {
    background: var(--cs-active-bg);
    color: var(--cs-active-text);
    border-color: transparent;
  }

  /* Image stage */
  .color-switch__stage {
    position: relative;
    border-radius: var(--cs-radius);
    overflow: hidden;
    background: {{ section.settings.stage_background }};
    aspect-ratio: {{ section.settings.image_ratio }};
  }

  .color-switch__panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease;
  }

  .color-switch__panel.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 1;
  }

  .color-switch__panel img,
  .color-switch__panel .placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
  }

  .color-switch__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 16px 20px;
    font-size: 14px;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #ffffff;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0));
  }

  /* Desktop: text + buttons in a left column, image in a right column. */
  @media screen and (min-width: 990px) {
    .color-switch {
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      column-gap: {{ section.settings.column_gap }}px;
    }

    .color-switch--img-left .color-switch__content {
      order: 2;
    }

    .color-switch--img-left .color-switch__stage {
      order: 1;
    }

    .color-switch__content {
      min-width: 0;
    }

    /* The alignment setting stops at this breakpoint on purpose: from here the
       section is a two-column grid and a centred header floating over the left
       half reads as a mistake. Below 990px the setting is fully in charge. */
    .color-switch__header {
      text-align: left;
    }

    .color-switch__subs {
      margin-inline: 0;
      max-width: none;
    }

    .color-switch__subheading {
      text-align: left;
    }

    .color-switch__buttons {
      display: grid;
      grid-template-columns: 1fr 1fr;
      margin-bottom: 0;
    }

    .color-switch__stage {
      margin: 0;
    }
  }
</style>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width color-switch__wrap section-{{ section.id }}-padding">
    <div
      class="color-switch color-switch-{{ section.id }} color-switch--img-{{ section.settings.image_position }}"
      data-color-switch
    >
      <div class="color-switch__content">
        {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
          <div class="color-switch__header">
            {%- if section.settings.eyebrow != blank -%}
              <p class="color-switch__eyebrow">{{ section.settings.eyebrow | escape }}</p>
            {%- endif -%}

            {%- if section.settings.heading != blank -%}
              <h2 class="color-switch__heading{% unless section.settings.heading_size == 'custom' %} {{ section.settings.heading_size }}{% endunless %}">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <div class="color-switch__subs">
            {%- for block in section.blocks -%}
              {%- if block.settings.subheading != blank -%}
                <p
                  class="color-switch__subheading{% if forloop.first %} is-active{% endif %}"
                  data-cs-sub="{{ forloop.index0 }}"
                >
                  {{ block.settings.subheading }}
                </p>
              {%- else -%}
                <p
                  class="color-switch__subheading{% if forloop.first %} is-active{% endif %}"
                  data-cs-sub="{{ forloop.index0 }}"
                  aria-hidden="true"
                ></p>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="color-switch__buttons" role="tablist">
            {%- for block in section.blocks -%}
              <button
                type="button"
                role="tab"
                class="color-switch__btn{% if forloop.first %} is-active{% endif %}"
                data-cs-btn="{{ forloop.index0 }}"
                aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-controls="cs-panel-{{ section.id }}-{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.label | default: 'Option' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="color-switch__stage">
          {%- for block in section.blocks -%}
            <div
              class="color-switch__panel{% if forloop.first %} is-active{% endif %}"
              id="cs-panel-{{ section.id }}-{{ forloop.index0 }}"
              data-cs-panel="{{ forloop.index0 }}"
              role="tabpanel"
              {% unless forloop.first %}hidden{% endunless %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: 'lazy',
                    widths: '350, 535, 750, 1070, 1400',
                    sizes: '(min-width: 990px) 600px, 100vw',
                    alt: block.settings.label
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}

              {%- if block.settings.caption != blank -%}
                <p class="color-switch__caption">{{ block.settings.caption }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    function initColorSwitch(root) {
      if (!root || root.dataset.csInit === 'true') return;
      root.dataset.csInit = 'true';

      var buttons = Array.prototype.slice.call(root.querySelectorAll('[data-cs-btn]'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('[data-cs-panel]'));
      var subs = Array.prototype.slice.call(root.querySelectorAll('[data-cs-sub]'));
      if (!buttons.length) return;

      function select(index) {
        buttons.forEach(function (btn) {
          var active = btn.getAttribute('data-cs-btn') === String(index);
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });

        subs.forEach(function (sub) {
          sub.classList.toggle('is-active', sub.getAttribute('data-cs-sub') === String(index));
        });

        panels.forEach(function (panel) {
          var active = panel.getAttribute('data-cs-panel') === String(index);
          panel.classList.toggle('is-active', active);
          if (active) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      }

      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          select(btn.getAttribute('data-cs-btn'));
        });
      });
    }

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-color-switch]').forEach(initColorSwitch);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (e) {
      e.target.querySelectorAll('[data-color-switch]').forEach(function (el) {
        el.dataset.csInit = '';
        initColorSwitch(el);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Color switch",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Small uppercase line above the heading. Leave empty to hide it."
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow size",
      "default": 11
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#634c61"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "When does it matter?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "info": "Sizes follow the theme typography settings",
      "options": [
        { "value": "h3", "label": "Extra small" },
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h0"
    },
    {
      "type": "number",
      "id": "heading_custom_desktop_size",
      "label": "Custom desktop size",
      "default": 40,
      "visible_if": "{{ section.settings.heading_size == 'custom' }}"
    },
    {
      "type": "number",
      "id": "heading_custom_mobile_size",
      "label": "Custom mobile size",
      "default": 34,
      "visible_if": "{{ section.settings.heading_size == 'custom' }}"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading & subheading color",
      "default": "#25162f"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centered" }
      ],
      "default": "left",
      "info": "From 990px the header is always left-aligned: the section becomes a two-column grid there."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "range",
      "id": "button_gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Gap between buttons",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Button corner radius",
      "default": 8
    },
    {
      "type": "color",
      "id": "button_active_background",
      "label": "Active background",
      "default": "#cbff78",
      "info": "Only the selected button gets this color."
    },
    {
      "type": "color",
      "id": "button_active_text",
      "label": "Active text",
      "default": "#25162f"
    },
    {
      "type": "color",
      "id": "button_inactive_text",
      "label": "Inactive text",
      "default": "#25162f"
    },
    {
      "type": "color",
      "id": "button_inactive_border",
      "label": "Inactive border",
      "default": "#d2cdc7"
    },
    {
      "type": "header",
      "content": "Layout (desktop)"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Max content width",
      "default": 1100
    },
    {
      "type": "select",
