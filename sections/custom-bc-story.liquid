{%- comment -%}
  Black Cherry waitlist — section 9 "Merkverhaal".
  Two paragraphs plus a two-up portrait image pair.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign image_count = 0
  for block in section.blocks
    if block.type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-story {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7vw, {{ s.heading_size_max }}px);
  }
{%- endstyle -%}

{%- comment -%}
  The .bc-split__body / __aside wrappers are transparent on mobile
  (display: contents, see custom-bc.css) and become the two desktop columns. On
  desktop the images sit left of the copy, which is a placement in the CSS, not a
  different DOM order — the copy stays first for reading order.
{%- endcomment -%}
<section class="bc-story">
  <div class="bc-inner bc-split">
    <div class="bc-split__body">
      {%- if s.eyebrow != blank -%}
        <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="bc-h2">{{ s.heading | escape }}</h2>
      {%- endif -%}

      {%- if s.body != blank -%}
        <div class="bc-body">{{ s.body }}</div>
      {%- endif -%}

      {%- if s.body_second != blank -%}
        <div class="bc-body">{{ s.body_second }}</div>
      {%- endif -%}
    </div>

    {%- if image_count > 0 -%}
      <div class="bc-split__aside">
        <ul class="bc-story__media" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'image' -%}
              {%- liquid
                assign img = block.settings.image
                assign img_alt = img.alt | default: block.settings.alt_fallback | strip_html | escape
              -%}
              <li class="bc-media bc-story__item" {{ block.shopify_attributes }}>
                {%- if img != blank -%}
                  {{-
                    img
                    | image_url: width: 780
                    | image_tag:
                      width: img.width,
                      height: img.height,
                      alt: img_alt,
                      sizes: '(min-width: 1264px) 249px, (min-width: 950px) 21vw, (min-width: 552px) 260px, 50vw',
                      widths: '260, 390, 520, 780',
                      loading: 'lazy',
                      decoding: 'async'
                  -}}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BC · Merkverhaal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why we started"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Feeling good shouldn't feel like a full-time job."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heading minimum",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "min": 24,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Heading maximum",
      "default": 34
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Tekst",
      "default": "<p>Daily Matters is ontstaan vanuit een simpele overtuiging: goed voor jezelf zorgen hoeft niet ingewikkeld, extreem of perfect te zijn. Het gaat meestal niet om wat je één keer doet, maar om wat je makkelijk genoeg maakt om te blijven herhalen.</p>"
    },
    {
      "type": "richtext",
      "id": "body_second",
      "label": "Tweede alinea",
      "default": "<p>Daarom ontwikkelen we producten die passen in het echte leven. Duidelijke formules, eenvoudige routines en smaken waar je daadwerkelijk naar uitkijkt.</p>"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrond",
      "default": "#f8f8ed"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#634c61"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#180223"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Tekst",
      "default": "#504056"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Afbeelding",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "alt_fallback",
          "label": "Alt-tekst (terugval)"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "BC · Merkverhaal",
      "blocks": [
        { "type": "image", "settings": { "alt_fallback": "Founder met de eerste samples" } },
        { "type": "image", "settings": { "alt_fallback": "Eerste samples en verpakkingsontwikkeling" } }
      ]
    }
  ]
}
{% endschema %}
