{%- comment -%}
  Black Cherry waitlist — section 6 "Ingrediënten".
  Native <details> accordions: open/close, keyboard support and find-in-page all
  come for free, and the content is in the DOM for crawlers even when collapsed.
  Carries the #bc-ingredients anchor the hero links to.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign item_count = 0
  for block in section.blocks
    if block.type == 'ingredient'
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-ingredients {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7.6vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-ingredient__badge {
    background: {{ s.badge_bg_color }};
    color: {{ s.badge_icon_color }};
  }
{%- endstyle -%}

<section class="bc-ingredients" id="bc-ingredients">
  <div class="bc-inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="bc-body">{{ s.body }}</div>
    {%- endif -%}

    {%- if item_count > 0 -%}
      <ul class="bc-ingredients__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'ingredient' and block.settings.name != blank -%}
            <li {{ block.shopify_attributes }}>
              <details class="bc-acc bc-ingredient">
                <summary>
                  <span class="bc-ingredient__badge">
                    {% render 'custom-bc-icon', icon: block.settings.icon, size: 19 %}
                  </span>
                  <span class="bc-ingredient__label">
                    <span class="bc-ingredient__name">{{ block.settings.name | escape }}</span>
                    {%- if block.settings.meta != blank -%}
                      <span class="bc-ingredient__meta">{{ block.settings.meta | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="bc-acc__chev">
                    {% render 'custom-bc-icon', icon: 'expand_more', size: 21 %}
                  </span>
                </summary>
                {%- if block.settings.text != blank -%}
                  <div class="bc-ingredient__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </details>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if s.claims_text != blank -%}
      <div class="bc-claims">
        {%- if s.claims_title != blank -%}
          <h3 class="bc-claims__title">{{ s.claims_title | escape }}</h3>
        {%- endif -%}
        <div class="bc-claims__text">{{ s.claims_text }}</div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
