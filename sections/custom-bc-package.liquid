{%- comment -%}
  Black Cherry waitlist — section 11 "What you'll get".

  Price and delivery are plain text settings, not money/date filters: at waitlist
  stage these are estimates in brackets ("[€ 49]", "[najaar 2026]"), not a real
  product price. Once there is a Shopify product, swap them for the product's own
  price rendered with the money filter.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign image = s.image
  assign image_alt = image.alt | default: s.card_title | strip_html | escape

  assign item_count = 0
  for block in section.blocks
    if block.type == 'item'
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-package-section {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7.6vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-package {
    --bc-package-bg: {{ s.card_bg_color }};
  }

  #shopify-section-{{ section.id }} .bc-package__flag {
    background: {{ s.flag_bg_color }};
    color: {{ s.flag_text_color }};
  }
{%- endstyle -%}

<section class="bc-package-section">
  <div class="bc-inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    <div class="bc-package">
      <div class="bc-media bc-package__media">
        {%- if image != blank -%}
          {{-
            image
            | image_url: width: 1040
            | image_tag:
              width: image.width,
              height: image.height,
              alt: image_alt,
              sizes: '(min-width: 552px) 520px, 100vw',
              widths: '390, 520, 780, 1040',
              loading: 'lazy',
              decoding: 'async'
          -}}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- if s.flag != blank -%}
          <span class="bc-package__flag">{{ s.flag | escape }}</span>
        {%- endif -%}
      </div>

      <div class="bc-package__body">
        {%- if s.card_title != blank -%}
          <h3 class="bc-package__title">{{ s.card_title | escape }}</h3>
        {%- endif -%}

        {%- if item_count > 0 -%}
          <ul class="bc-package__list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'item' and block.settings.text != blank -%}
                <li class="bc-package__item" {{ block.shopify_attributes }}>
                  <span class="bc-package__mark">
                    {% render 'custom-bc-icon', icon: block.settings.icon, size: 14 %}
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.price_label != blank or s.delivery_label != blank -%}
          <dl class="bc-package__facts">
            {%- if s.price_label != blank -%}
              <div class="bc-package__fact">
                <dt>{{ s.price_title | escape }}</dt>
                <dd>{{ s.price_label | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if s.delivery_label != blank -%}
              <div class="bc-package__fact">
                <dt>{{ s.delivery_title | escape }}</dt>
                <dd>{{ s.delivery_label | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BC · Wat je krijgt",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What you'll get"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your 30-day foundation."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "min": 20,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Heading minimum",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "min": 26,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading maximum",
      "default": 38
    },
    {
      "type": "header",
      "content": "Kaart"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Afbeelding",
      "info": "16:10. Ontwerpbriefing: de founding box met 30 sachets en Black Cherry-branding."
    },
    {
      "type": "text",
      "id": "flag",
      "label": "Label op de afbeelding",
      "default": "First batch"
    },
    {
      "type": "text",
      "id": "card_title",
      "label": "Titel",
      "default": "Energy Foundation — Black Cherry"
    },
    {
      "type": "text",
      "id": "price_title",
      "label": "Label prijs",
      "default": "Verwachte prijs"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Prijs",
      "default": "[€ 49]"
    },
    {
      "type": "text",
      "id": "delivery_title",
      "label": "Label levering",
      "default": "Verwachte levering"
    },
    {
      "type": "text",
      "id": "delivery_label",
      "label": "Levering",
      "default": "[najaar 2026]"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#634c61"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#180223"
    },
    {
      "type": "color",
      "id": "card_bg_color",
      "label": "Kaart achtergrond",
      "default": "#fee7e7"
    },
    {
      "type": "color",
      "id": "flag_bg_color",
      "label": "Label achtergrond",
      "default": "#511a39"
    },
    {
      "type": "color",
      "id": "flag_text_color",
      "label": "Label tekst",
      "default": "#f8f8ed"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Regel",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "check", "label": "Vinkje" },
            { "value": "water_drop", "label": "Druppel" },
            { "value": "calendar_month", "label": "Kalender" },
            { "value": "bolt", "label": "Bliksem" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "30 dagelijkse sachets · één per dag"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "BC · Wat je krijgt",
      "blocks": [
        { "type": "item", "settings": { "icon": "check", "text": "30 dagelijkse sachets · één per dag" } },
        { "type": "item", "settings": { "icon": "check", "text": "Meng met 500 ml koud water" } },
        {
          "type": "item",
          "settings": { "icon": "check", "text": "Zonder cafeïne · zonder toegevoegde suikers*" }
        },
        {
          "type": "item",
          "settings": { "icon": "water_drop", "text": "Voeg de Daily Matters bottle toe bij launch" }
        }
      ]
    }
  ]
}
{% endschema %}
