{%- comment -%}
  Black Cherry waitlist — section 11 "What you'll get".

  Pricing has two modes:
  - A product is picked -> the real price comes from Shopify and the early-adopter
    price is derived from it with the discount percentage. Both are rendered with
    the money filter, so currency and formatting follow the store and the market.
  - No product yet -> falls back to the plain text estimate ("[€ 49]"), which is
    what a waitlist page needs before the product exists.

  Delivery stays a text setting either way: "[najaar 2026]" is a guess, not a date.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign image = s.image
  assign image_alt = image.alt | default: s.card_title | strip_html | escape

  assign item_count = 0
  for block in section.blocks
    if block.type == 'item'
      assign item_count = item_count | plus: 1
    endif
  endfor

  assign product = s.product
  assign show_live_price = false
  assign show_discount = false

  if product != blank and product.price != blank
    assign show_live_price = true
    assign regular_price = product.price

    comment
      Prices are integer cents. Divide by 100.0 to force float maths, then round,
      so a 25% cut on € 49,90 lands on € 37,43 rather than truncating to € 37,42.
    endcomment
    assign multiplier = 100 | minus: s.discount_percent
    assign sale_price = regular_price | times: multiplier | divided_by: 100.0 | round
    assign saving = regular_price | minus: sale_price

    if s.discount_percent > 0 and saving > 0
      assign show_discount = true
    endif

    comment
      This shop's money_format is "{{amount_with_comma_separator}}" — no currency
      symbol — so | money renders a bare "47,00". Two bare numbers side by side on
      an ad landing page are ambiguous, hence the notation switch. Both branches
      stay inside Liquid's money filters: never hand-build a currency string, or
      it breaks the moment a second market is added.
    endcomment
    if s.money_format == 'compact'
      assign sale_display = sale_price | money
      assign regular_display = regular_price | money
      assign saving_display = saving | money
    else
      assign sale_display = sale_price | money_with_currency
      assign regular_display = regular_price | money_with_currency
      assign saving_display = saving | money_with_currency
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-package-section {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7.6vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-package {
    --bc-package-bg: {{ s.card_bg_color }};
  }

  #shopify-section-{{ section.id }} .bc-package__flag {
    background: {{ s.flag_bg_color }};
    color: {{ s.flag_text_color }};
  }

  #shopify-section-{{ section.id }} .bc-package__price {
    --bc-price-now: {{ s.price_now_color }};
    --bc-price-was: {{ s.price_was_color }};
    --bc-price-badge-bg: {{ s.badge_bg_color }};
    --bc-price-badge-ink: {{ s.badge_text_color }};
  }
{%- endstyle -%}

<section class="bc-package-section">
  <div class="bc-inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    <div class="bc-package">
      <div class="bc-media bc-package__media">
        {%- if image != blank -%}
          {{-
            image
            | image_url: width: 1040
            | image_tag:
              width: image.width,
              height: image.height,
              alt: image_alt,
              sizes: '(min-width: 552px) 520px, 100vw',
              widths: '390, 520, 780, 1040',
              loading: 'lazy',
              decoding: 'async'
          -}}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- if s.flag != blank -%}
          <span class="bc-package__flag">{{ s.flag | escape }}</span>
        {%- endif -%}
      </div>

      <div class="bc-package__body">
        {%- if s.card_title != blank -%}
          <h3 class="bc-package__title">{{ s.card_title | escape }}</h3>
        {%- endif -%}

        {%- if item_count > 0 -%}
          <ul class="bc-package__list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'item' and block.settings.text != blank -%}
                <li class="bc-package__item" {{ block.shopify_attributes }}>
                  <span class="bc-package__mark">
                    {% render 'custom-bc-icon', icon: block.settings.icon, size: 14 %}
                  </span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if show_live_price -%}
          <div class="bc-package__price{% if show_discount %} bc-package__price--discounted{% endif %}">
            <p class="bc-package__price-label">
              {{- s.price_title | escape -}}
            </p>

            <p class="bc-package__price-row">
              {%- comment -%}
                Screen readers get an explicit label per amount: two bare prices
                next to each other say nothing about which one you actually pay.
              {%- endcomment -%}
              <span class="bc-vh">{{ s.now_label }}:</span>
              <span class="bc-package__price-now">{{ sale_display }}</span>

              {%- if show_discount -%}
                <span class="bc-vh">{{ s.compare_label }}:</span>
                <s class="bc-package__price-was">{{ regular_display }}</s>
                <span class="bc-package__price-badge">-{{ s.discount_percent }}%</span>
              {%- endif -%}
            </p>

            {%- if show_discount and s.saving_prefix != blank -%}
              <p class="bc-package__price-note">
                {{ s.saving_prefix | escape }} {{ saving_display }}
              </p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign show_manual_price = false
          if show_live_price == false and s.price_label != blank
            assign show_manual_price = true
          endif
        -%}

        {%- if show_manual_price or s.delivery_label != blank -%}
          <dl class="bc-package__facts">
            {%- if show_manual_price -%}
              <div class="bc-package__fact">
                <dt>{{ s.price_title | escape }}</dt>
                <dd>{{ s.price_label | escape }}</dd>
              </div>
            {%- endif -%}
            {%- if s.delivery_label != blank -%}
              <div class="bc-package__fact">
                <dt>{{ s.delivery_title | escape }}</dt>
                <dd>{{ s.delivery_label | escape }}</dd>
              </div>
            {%- endif -%}
          </dl>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

