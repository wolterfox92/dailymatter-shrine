{%- comment -%}
  Black Cherry waitlist — sectie 7 "Smaken".

  Was één smaak (Black Cherry) als vast paneel; toont nu alle smaken van de
  eerste batch als horizontale scroller, zodat bezoekers kunnen vergelijken en
  bij hun aanmelding hun favoriet kunnen doorgeven.

  De scroller is native: flexbox + `overflow-x` + scroll-snap, geen JS en geen
  library. De volgende kaart piept opzettelijk voorbij de rand — dat is de enige
  affordance die zegt "hier valt te schuiven". Toetsenbord: de scroller heeft
  `tabindex="0"` en een label, dus pijltjestoetsen scrollen hem. Dat is de
  sleep-alternatief die WCAG 2.5.7 vraagt; knoppen zouden JS kosten.

  De smaakassen (Fruity, Sweet, …) staan één keer op sectieniveau: ze moeten
  over alle kaarten gelijk zijn, anders vergelijk je niets. Elke smaakblok zet
  alleen de score per as. As leeg = die rij verdwijnt op alle kaarten.

  De bolletjesschaal is decoratief; elke rij draagt zijn score ook als tekst,
  want een rij gekleurde rondjes zegt niets tegen een screenreader.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign flavour_count = 0
  for block in section.blocks
    if block.type == 'flavour'
      assign flavour_count = flavour_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-flavours {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-flavours-note: {{ s.note_color }};
    --bc-flavour-card-bg: {{ s.card_bg_color }};
    --bc-flavour-tagline: {{ s.tagline_color }};
    --bc-media-bg: {{ s.media_bg_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 9vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-flavour-card__name,
  #shopify-section-{{ section.id }} .bc-taste__label {
    color: {{ s.heading_color }};
  }

  #shopify-section-{{ section.id }} .bc-taste__dot--on {
    background: {{ s.dot_color }};
  }
{%- endstyle -%}

<section class="bc-flavours">
  <div class="bc-flavours__head">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="bc-body">{{ s.body }}</div>
    {%- endif -%}

    {%- if s.note != blank -%}
      <div class="bc-flavours__note">{{ s.note }}</div>
    {%- endif -%}
  </div>

  {%- if flavour_count > 0 -%}
    <div
      class="bc-flavours__scroller"
      role="region"
      aria-label="{{ s.scroller_label | default: s.heading | escape }}"
      tabindex="0"
    >
      <ul class="bc-flavours__track" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type != 'flavour' -%}
            {%- continue -%}
          {%- endif -%}

          {%- liquid
            assign card_image = block.settings.image
            assign card_alt = card_image.alt | default: block.settings.name | strip_html | escape
          -%}

          <li
            class="bc-flavour-card"
            style="--bc-flavour-accent: {{ block.settings.accent_color }};"
            {{ block.shopify_attributes }}
          >
            <div class="bc-media bc-flavour-card__media">
              {%- if card_image != blank -%}
                {{-
                  card_image
                  | image_url: width: 760
                  | image_tag:
                    width: card_image.width,
                    height: card_image.height,
                    alt: card_alt,
                    sizes: '(min-width: 1264px) 346px, (min-width: 950px) 29vw, (min-width: 552px) 380px, 77vw',
                    widths: '300, 380, 560, 760',
                    loading: 'lazy',
                    decoding: 'async'
                -}}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="bc-flavour-card__body">
              {%- if block.settings.name != blank -%}
                <h3 class="bc-flavour-card__name">
                  <span class="bc-flavour-card__dot" aria-hidden="true"></span>
                  {{ block.settings.name | escape }}
                </h3>
              {%- endif -%}

              {%- if block.settings.tagline != blank -%}
                <p class="bc-flavour-card__tagline">{{ block.settings.tagline | escape }}</p>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="bc-flavour-card__text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

              <ul class="bc-taste__rows" role="list">
                {%- for i in (1..4) -%}
                  {%- liquid
                    assign axis_key = 'axis_' | append: i
                    assign axis_label = section.settings[axis_key]
                    assign score_key = 'score_' | append: i
                    assign score = block.settings[score_key]
                  -%}
                  {%- if axis_label == blank -%}
                    {%- continue -%}
                  {%- endif -%}

                  <li class="bc-taste__row">
                    <span class="bc-taste__label">{{ axis_label | escape }}</span>
                    <span class="bc-taste__dots" aria-hidden="true">
                      {%- for dot in (1..5) -%}
                        <span class="bc-taste__dot{% if dot <= score %} bc-taste__dot--on{% endif %}"></span>
                      {%- endfor -%}
                    </span>
                    <span class="bc-vh">{{ score }} van 5</span>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

