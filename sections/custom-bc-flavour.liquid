{%- comment -%}
  Black Cherry waitlist — section 7 "Black Cherry".
  Dark cherry panel with the flavour image and a taste profile. The dot scale is
  decorative; each row also carries its score as text for screen readers, since
  a row of coloured circles says nothing on its own.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign image = s.image
  assign image_alt = image.alt | default: s.heading | strip_html | escape

  assign row_count = 0
  for block in section.blocks
    if block.type == 'taste'
      assign row_count = row_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-flavour {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-flavour-tagline: {{ s.tagline_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 9vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-taste__title,
  #shopify-section-{{ section.id }} .bc-taste__dot--on {
    color: {{ s.dot_color }};
  }

  #shopify-section-{{ section.id }} .bc-taste__dot--on {
    background: {{ s.dot_color }};
  }

  #shopify-section-{{ section.id }} .bc-taste__label {
    color: {{ s.heading_color }};
  }
{%- endstyle -%}

<section class="bc-flavour">
  <div class="bc-flavour__inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="bc-body">{{ s.body }}</div>
    {%- endif -%}

    {%- if s.tagline != blank -%}
      <p class="bc-flavour__tagline">{{ s.tagline | escape }}</p>
    {%- endif -%}

    <div class="bc-media bc-flavour__media">
      {%- if image != blank -%}
        {{-
          image
          | image_url: width: 1040
          | image_tag:
            width: image.width,
            height: image.height,
            alt: image_alt,
            sizes: '(min-width: 552px) 520px, 100vw',
            widths: '390, 520, 780, 1040',
            loading: 'lazy',
            decoding: 'async'
        -}}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if row_count > 0 -%}
      <div class="bc-taste">
        {%- if s.taste_title != blank -%}
          <h3 class="bc-taste__title">{{ s.taste_title | escape }}</h3>
        {%- endif -%}

        <ul class="bc-taste__rows" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'taste' and block.settings.label != blank -%}
              {%- assign score = block.settings.score -%}
              <li class="bc-taste__row" {{ block.shopify_attributes }}>
                <span class="bc-taste__label">{{ block.settings.label | escape }}</span>
                <span class="bc-taste__dots" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- if i <= score -%}
                      <span class="bc-taste__dot bc-taste__dot--on"></span>
                    {%- else -%}
                      <span class="bc-taste__dot"></span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
                <span class="bc-vh">{{ score }} van 5</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BC · Smaak",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "First flavour"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Black Cherry."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "min": 22,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Heading minimum",
      "default": 32
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "min": 28,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Heading maximum",
      "default": 44
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Tekst",
      "default": "<p>Diep, fruitig en licht fris. Black Cherry heeft een volle kersensmaak zonder te voelen als siroop, snoep of een overdreven zoete sportdrank.</p>"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Dark cherry, bright finish."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Afbeelding",
      "info": "Staand 4:5. Ontwerpbriefing: glas of fles met donkerrode vloeistof, condens en ijs."
    },
    {
      "type": "text",
      "id": "taste_title",
      "label": "Titel smaakprofiel",
      "default": "Smaakprofiel"
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrond",
      "default": "#511a39"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#cbff78"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#f8f8ed"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Tekst",
      "default": "#d7ccc9"
    },
    {
      "type": "color",
      "id": "tagline_color",
      "label": "Tagline",
      "default": "#ff9cff"
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Smaakscore",
      "default": "#cbff78"
    }
  ],
  "blocks": [
    {
      "type": "taste",
      "name": "Smaakregel",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Fruity"
        },
        {
          "type": "range",
          "id": "score",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Score",
          "default": 4
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "BC · Smaak",
      "blocks": [
        { "type": "taste", "settings": { "label": "Fruity", "score": 4 } },
        { "type": "taste", "settings": { "label": "Sweet", "score": 3 } },
        { "type": "taste", "settings": { "label": "Fresh", "score": 3 } },
        { "type": "taste", "settings": { "label": "Bold", "score": 4 } }
      ]
    }
  ]
}
{% endschema %}
