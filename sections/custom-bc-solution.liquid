{%- comment -%}
  Black Cherry waitlist — section 4 "Oplossing".
  Three numbered step cards. The step numbers come from the loop, not from a
  setting, so reordering blocks in the editor renumbers them automatically.
{%- endcomment -%}

{%- liquid
  assign s = section.settings

  assign step_count = 0
  for block in section.blocks
    if block.type == 'step'
      assign step_count = step_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .bc-solution {
    background: {{ s.bg_color }};
    --bc-eyebrow-color: {{ s.eyebrow_color }};
    --bc-heading-color: {{ s.heading_color }};
    --bc-body-color: {{ s.body_color }};
    --bc-h2-size: clamp({{ s.heading_size_min }}px, 7.6vw, {{ s.heading_size_max }}px);
  }

  #shopify-section-{{ section.id }} .bc-card__num {
    background: {{ s.badge_bg_color }};
    color: {{ s.badge_text_color }};
  }
{%- endstyle -%}

<section class="bc-solution">
  <div class="bc-inner">
    {%- if s.eyebrow != blank -%}
      <p class="bc-eyebrow">{{ s.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h2 class="bc-h2">{{ s.heading | escape }}</h2>
    {%- endif -%}

    {%- if s.body != blank -%}
      <div class="bc-body">{{ s.body }}</div>
    {%- endif -%}

    {%- if step_count > 0 -%}
      <ol class="bc-cards">
        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- liquid
              assign step_index = step_index | plus: 1
              assign img = block.settings.image
              assign img_alt = img.alt | default: block.settings.title | strip_html | escape
            -%}
            <li class="bc-card" {{ block.shopify_attributes }}>
              <div class="bc-media bc-card__media">
                {%- if img != blank -%}
                  {{-
                    img
                    | image_url: width: 1040
                    | image_tag:
                      width: img.width,
                      height: img.height,
                      alt: img_alt,
                      sizes: '(min-width: 552px) 520px, 100vw',
                      widths: '390, 520, 780, 1040',
                      loading: 'lazy',
                      decoding: 'async'
                  -}}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>

              <div class="bc-card__body">
                <div class="bc-card__titlerow">
                  {%- if s.show_numbers -%}
                    <span class="bc-card__num" aria-hidden="true">{{ step_index }}</span>
                  {%- endif -%}
                  {%- if block.settings.title != blank -%}
                    <h3 class="bc-card__title">{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                </div>
                {%- if block.settings.text != blank -%}
                  <p class="bc-card__text">{{ block.settings.text | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "BC · Oplossing",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Less to manage"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One sachet. One bottle. Done."
    },
    {
      "type": "range",
      "id": "heading_size_min",
      "min": 20,
      "max": 44,
      "step": 1,
      "unit": "px",
      "label": "Heading minimum",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_size_max",
      "min": 26,
      "max": 64,
      "step": 1,
      "unit": "px",
      "label": "Heading maximum",
      "default": 38
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Tekst",
      "default": "<p>Energy Foundation brengt ingrediënten voor energiehuishouding, mentale performance en fysieke prestaties samen in één dagelijkse drinkmix. Scheur een sachet open, meng met koud water en ga verder met je dag.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Nummers tonen",
      "default": true
    },
    {
      "type": "header",
      "content": "Kleuren"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Achtergrond",
      "default": "#cac0ff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#45325a"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#180223"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Tekst",
      "default": "#45325a"
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Nummer achtergrond",
      "default": "#cbff78"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Nummer tekst",
      "default": "#243511"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Afbeelding"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Prepare"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Scheur één sachet open."
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "BC · Oplossing",
      "blocks": [
        { "type": "step", "settings": { "title": "Prepare", "text": "Scheur één sachet open." } },
        { "type": "step", "settings": { "title": "Mix", "text": "Meng met 500 ml koud water." } },
        { "type": "step", "settings": { "title": "Go", "text": "Drink en ga verder met je dag." } }
      ]
    }
  ]
}
{% endschema %}
