{% liquid
  if section.settings.product_images == 'all' or section.settings.product_images == 'one'
    assign product = section.settings.product
  endif

  assign s = block.settings
  assign title = s.custom_title
  if s.title_source == 'product' or title == blank
    assign title = product.title
  endif
%}

<div
  class="dm-product-title dm-product-title-{{ block.id }} {{ s.visibility }}"
  {{ block.shopify_attributes }}
>
  <{{ s.heading_tag }} class="dm-product-title__heading{% unless s.title_size == 'custom' %} {{ s.title_size }}{% endunless %}">
    {{- title -}}
  </{{ s.heading_tag }}>

  {%- if s.subtitle != blank or s.subtitle_highlight != blank -%}
    <p class="dm-product-title__subtitle{% unless s.subtitle_size == 'custom' %} {{ s.subtitle_size }}{% endunless %}">
      {%- if s.subtitle != blank -%}
        <span>{{ s.subtitle }}</span>
      {%- endif %}
      {%- if s.subtitle_highlight != blank -%}
        <mark class="dm-product-title__highlight">{{ s.subtitle_highlight }}</mark>
      {%- endif -%}
    </p>
  {%- endif -%}
</div>

{% style %}
  .dm-product-title-{{ block.id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    margin-top: {{ s.margin_top | divided_by: 10.0 }}rem;
    margin-bottom: {{ s.margin_bottom | divided_by: 10.0 }}rem;
  }

  .dm-product-title-{{ block.id }} .dm-product-title__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    color: {{ s.text_color }};
  }

  {%- if s.title_size == 'custom' %}
  .dm-product-title-{{ block.id }} .dm-product-title__heading {
    font-size: {{ s.title_custom_mobile_size | divided_by: 10.0 }}rem;
    line-height: 1.1;
  }
  {%- endif %}

  .dm-product-title-{{ block.id }} .dm-product-title__subtitle {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    color: {{ s.text_color }};
  }

  {%- if s.subtitle_size == 'custom' %}
  .dm-product-title-{{ block.id }} .dm-product-title__subtitle {
    font-size: {{ s.subtitle_custom_size | divided_by: 10.0 }}rem;
    line-height: 1.3;
  }
  {%- endif %}

  .dm-product-title-{{ block.id }} .dm-product-title__highlight {
    background: {{ s.highlight_bg_color }};
    color: {{ s.highlight_text_color }};
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  {%- if s.title_size == 'custom' %}
  @media screen and (min-width: 750px) {
    .dm-product-title-{{ block.id }} .dm-product-title__heading {
      font-size: {{ s.title_custom_desktop_size | divided_by: 10.0 }}rem;
    }
  }
  {%- endif %}
{% endstyle %}

{% schema %}
{
  "name": "DM Title & subtitle",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#25162f"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "select",
      "id": "title_source",
      "label": "Source",
      "options": [
        { "value": "product", "label": "Product title" },
        { "value": "custom", "label": "Custom text" }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "custom_title",
      "label": "Custom title",
      "info": "Only used when Source is set to Custom text"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "info": "Use H1 once per page for SEO",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "p", "label": "Paragraph" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "info": "Sizes follow the theme typography settings",
      "options": [
        { "value": "h3", "label": "Extra small" },
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" },
        { "value": "hxl", "label": "Extra large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h0"
    },
    {
      "type": "number",
      "id": "title_custom_desktop_size",
      "label": "Custom desktop size",
      "default": 52,
      "visible_if": "{{ block.settings.title_size == 'custom' }}"
    },
    {
      "type": "number",
      "id": "title_custom_mobile_size",
      "label": "Custom mobile size",
      "default": 38,
      "visible_if": "{{ block.settings.title_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Subtitle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Not a spike."
    },
    {
      "type": "text",
      "id": "subtitle_highlight",
      "label": "Highlighted part",
      "info": "Shown after the subtitle with a marker background",
      "default": "A refill."
    },
    {
      "type": "select",
      "id": "subtitle_size",
      "label": "Subtitle size",
      "info": "Sizes follow the theme typography settings",
      "options": [
        { "value": "h5", "label": "Extra small" },
        { "value": "h4", "label": "Small" },
        { "value": "h3", "label": "Medium" },
        { "value": "h2", "label": "Large" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "h3"
    },
    {
      "type": "number",
      "id": "subtitle_custom_size",
      "label": "Custom subtitle size",
      "default": 21,
      "visible_if": "{{ block.settings.subtitle_size == 'custom' }}"
    },
    {
      "type": "color",
      "id": "highlight_bg_color",
      "label": "Highlight background",
      "default": "#cbff78"
    },
    {
      "type": "color",
      "id": "highlight_text_color",
      "label": "Highlight text color",
      "default": "#25162f"
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top",
      "min": 0,
      "max": 45,
      "step": 3,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 45,
      "step": 3,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "DM Title & subtitle",
      "category": "Product basics"
    }
  ]
}
{% endschema %}
