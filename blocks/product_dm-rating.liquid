{% liquid
  assign s = block.settings
%}

<div
  class="dm-product-rating dm-product-rating-{{ block.id }} {{ s.visibility }}"
  {{ block.shopify_attributes }}
>
  <span class="dm-product-rating__stars" role="img" aria-label="{{ s.rating_text | strip_html | escape }}">
    {%- for i in (1..5) -%}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
        <path d="M5.08203 4.26536L6.9487 1.8487C7.08203 1.67092 7.24036 1.54036 7.4237 1.45703C7.60703 1.3737 7.7987 1.33203 7.9987 1.33203C8.1987 1.33203 8.39036 1.3737 8.5737 1.45703C8.75703 1.54036 8.91536 1.67092 9.0487 1.8487L10.9154 4.26536L13.7487 5.21536C14.0376 5.30425 14.2654 5.46814 14.432 5.70703C14.5987 5.94592 14.682 6.20981 14.682 6.4987C14.682 6.63203 14.6626 6.76537 14.6237 6.8987C14.5848 7.03203 14.5209 7.15981 14.432 7.28203L12.5987 9.88203L12.6654 12.6154C12.6765 13.0043 12.5487 13.332 12.282 13.5987C12.0154 13.8654 11.7043 13.9987 11.3487 13.9987C11.3265 13.9987 11.2043 13.982 10.982 13.9487L7.9987 13.1154L5.01536 13.9487C4.95981 13.9709 4.8987 13.9848 4.83203 13.9904C4.76536 13.9959 4.70425 13.9987 4.6487 13.9987C4.29314 13.9987 3.98203 13.8654 3.71536 13.5987C3.4487 13.332 3.32092 13.0043 3.33203 12.6154L3.3987 9.86537L1.58203 7.28203C1.49314 7.15981 1.42925 7.03203 1.39036 6.8987C1.35148 6.76537 1.33203 6.63203 1.33203 6.4987C1.33203 6.22092 1.41259 5.96259 1.5737 5.7237C1.73481 5.48481 1.95981 5.31536 2.2487 5.21536L5.08203 4.26536Z" fill="currentColor"/>
      </svg>
    {%- endfor -%}
  </span>

  {%- if s.rating_text != blank -%}
    <span class="dm-product-rating__value">{{ s.rating_text }}</span>
  {%- endif -%}

  {%- if s.users_text != blank -%}
    <span class="dm-product-rating__users">{{ s.users_text }}</span>
  {%- endif -%}
</div>

{% style %}
  .dm-product-rating-{{ block.id }} {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: {{ s.margin_top | divided_by: 10.0 }}rem;
    margin-bottom: {{ s.margin_bottom | divided_by: 10.0 }}rem;
  }

  .dm-product-rating-{{ block.id }} .dm-product-rating__stars {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    color: {{ s.star_color }};
  }

  .dm-product-rating-{{ block.id }} .dm-product-rating__stars svg {
    display: block;
    width: {{ s.star_size | divided_by: 10.0 }}rem;
    height: {{ s.star_size | divided_by: 10.0 }}rem;
  }

  .dm-product-rating-{{ block.id }} .dm-product-rating__value {
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight);
    {%- if s.text_size == 'custom' %}
    font-size: {{ s.custom_text_size | divided_by: 10.0 }}rem;
    {%- endif %}
    line-height: 1;
    color: {{ s.text_color }};
    white-space: nowrap;
  }

  .dm-product-rating-{{ block.id }} .dm-product-rating__users {
    font-family: var(--font-body-family);
    {%- if s.text_size == 'custom' %}
    font-size: {{ s.custom_text_size | divided_by: 10.0 }}rem;
    {%- endif %}
    line-height: 1;
    color: {{ s.text_color | color_modify: 'alpha', 0.55 }};
  }
{% endstyle %}

{% schema %}
{
  "name": "DM Rating",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "visibility",
      "options": [
        { "value": "desktop-hidden", "label": "Mobile only" },
        { "value": "mobile-hidden", "label": "Desktop only" },
        { "value": "always-display", "label": "All devices" }
      ],
      "label": "Display on",
      "default": "always-display"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#25162f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#25162f"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating value",
      "default": "(4.9/5)"
    },
    {
      "type": "text",
      "id": "users_text",
      "label": "Reviews text",
      "default": "300+ dagelijkse gebruikers"
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text size",
      "options": [
        { "value": "default", "label": "Default (theme)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "default"
    },
    {
      "type": "number",
      "id": "custom_text_size",
      "label": "Custom text size",
      "default": 16,
      "visible_if": "{{ block.settings.text_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top",
      "min": 0,
      "max": 45,
      "step": 3,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 45,
      "step": 3,
      "unit": "px",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "DM Rating",
      "category": "Product basics"
    }
  ]
}
{% endschema %}
