{%- doc -%}
  Microsoft Clarity tracking tag.

  Per CLAUDE.md third-party scripts belong in an app embed, not in Liquid. This is
  a deliberate, documented exception: the "microsoft-clarity/blocks/clarity_js" app
  embed is enabled in settings_data.json but renders an empty block, because the
  Shopify app is not linked to a Clarity project. No tag reaches the page and the
  Data Export API returns empty metrics.

  IMPORTANT: remove the render and delete this file the moment the app embed starts
  emitting its own tag, or Clarity loads twice and double-counts every session.
  The embed injects via content_for_header, which this page also renders. As a
  safety net this snippet no-ops when window.clarity is already defined.

  @param project_id {String} - Clarity project ID (Clarity -> Settings -> Overview).

  @example
  {% render 'custom-clarity', project_id: 'y0trvvheh2' %}
{%- enddoc -%}

{%- if project_id != blank -%}
  <script>
    // The app embed injects via content_for_header, which this layout renders above
    // this snippet. So if the embed ever does reach this page, its tag has already
    // defined window.clarity by now and this one stands down rather than loading a
    // second tag and double-counting every session.
    if (!window.clarity) {
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', {{ project_id | json }});
    }
  </script>
{%- endif -%}
