{%- doc -%}
  Renders one of the built-in placeholder icons for the "Zo werkt het" timeline
  (sections/custom-how-it-works.liquid). Sizing and colour come from the parent
  marker (`width`/`height` in custom-how-it-works.css, `currentColor` for fill),
  so the SVG carries no dimensions of its own.

  @param {string} icon - Icon key: drop, salts, bolt, capsule, check, leaf, clock, sparkle, heart, moon.

  @example
  {% render 'custom-hiw-icon', icon: block.settings.icon %}
{%- enddoc -%}

{%- case icon -%}
  {%- when 'drop' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 2.5c4 5 6.5 8.2 6.5 11.4A6.5 6.5 0 0 1 12 20.4a6.5 6.5 0 0 1-6.5-6.5C5.5 10.7 8 7.5 12 2.5Z" fill="currentColor"/></svg>
  {%- when 'salts' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><g fill="currentColor"><circle cx="7" cy="7" r="2"/><circle cx="14" cy="5.5" r="1.5"/><circle cx="17.5" cy="11" r="2"/><circle cx="11" cy="12" r="2.4"/><circle cx="6" cy="15.5" r="1.8"/><circle cx="13.5" cy="18" r="2.1"/></g></svg>
  {%- when 'bolt' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z" fill="currentColor"/></svg>
  {%- when 'capsule' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><rect x="7.5" y="2.5" width="9" height="19" rx="4.5" fill="currentColor"/><path d="M9.5 6.5h5" stroke="var(--hiw-marker-bg, #fff)" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="m5 12.5 4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M20 4S6 4 5 14c-.5 5 3 6 3 6S6 10 20 4Z" fill="currentColor"/><path d="M8 20S9 11 17 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M12 6.8V12l3.4 2.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'sparkle' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 2.5c.8 5 2.7 6.9 7.7 7.7-5 .8-6.9 2.7-7.7 7.7-.8-5-2.7-6.9-7.7-7.7 5-.8 6.9-2.7 7.7-7.7Z" fill="currentColor"/><path d="M18.5 16.5c.4 2.3 1.3 3.2 3.6 3.6-2.3.4-3.2 1.3-3.6 3.6-.4-2.3-1.3-3.2-3.6-3.6 2.3-.4 3.2-1.3 3.6-3.6Z" fill="currentColor" opacity="0.7"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M12 20.5 4.2 13a4.7 4.7 0 0 1 0-6.7 4.7 4.7 0 0 1 6.7 0l1.1 1.1 1.1-1.1a4.7 4.7 0 0 1 6.7 0 4.7 4.7 0 0 1 0 6.7L12 20.5Z" fill="currentColor"/></svg>
  {%- when 'moon' -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" fill="currentColor"/></svg>
  {%- else -%}
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" focusable="false"><circle cx="12" cy="12" r="7.5" fill="currentColor"/></svg>
{%- endcase -%}
