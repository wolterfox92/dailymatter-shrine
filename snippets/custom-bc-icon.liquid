{%- doc -%}
  Renders one inline SVG icon for the Black Cherry waitlist sections.

  The Claude Design source used the Material Symbols Rounded webfont. That is a
  third-party Google font, which this theme does not load (see CLAUDE.md), so the
  glyphs are redrawn here as inline SVG: no extra request, no FOUT, and the icon
  inherits currentColor. These are close approximations of the Material shapes,
  not the originals — swap the paths here if the designer supplies real assets.

  Icons are decorative throughout these sections; they are marked aria-hidden and
  the surrounding text carries the meaning.

  @param {string} icon - Icon name, e.g. 'check', 'arrow_downward', 'water_drop'
  @param {number} [size] - Pixel size for width/height. Defaults to 20.

  @example
  {% render 'custom-bc-icon', icon: 'check', size: 16 %}
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 20
-%}
<svg
  class="bc-icon"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'arrow_downward' -%}
      <path d="M12 5v14M6 13l6 6 6-6" />
    {%- when 'arrow_upward' -%}
      <path d="M12 19V5M6 11l6-6 6 6" />
    {%- when 'arrow_forward' -%}
      <path d="M5 12h14M13 6l6 6-6 6" />
    {%- when 'expand_more' -%}
      <path d="M6 9l6 6 6-6" />
    {%- when 'check' -%}
      <path d="M5 12.5l4.5 4.5L19 7.5" />
    {%- when 'bolt' -%}
      <path d="M13 2L4.5 13.5H11L10 22l8.5-11.5H12L13 2z" fill="currentColor" stroke-width="1.5" />
    {%- when 'local_cafe' -%}
      <path d="M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z" />
      <path d="M16 9h2.5a2.5 2.5 0 0 1 0 5H16" />
      <path d="M7 2.5v2M11 2.5v2" />
    {%- when 'calendar_month' -%}
      <rect x="3.5" y="5" width="17" height="15.5" rx="3" />
      <path d="M3.5 10h17M8 2.5v4M16 2.5v4" />
      <path d="M8 14h.01M12 14h.01M16 14h.01M8 17.5h.01M12 17.5h.01" />
    {%- when 'local_florist' -%}
      <circle cx="12" cy="12" r="2.6" fill="currentColor" stroke="none" />
      <path d="M12 9.4c0-2.4-1-3.9-2.6-3.9S6.8 7 6.8 8.6 8.3 11 9.4 11" />
      <path d="M14.6 12c2.4 0 3.9-1 3.9-2.6S17 6.8 15.4 6.8 13 8.3 13 9.4" />
      <path d="M12 14.6c0 2.4 1 3.9 2.6 3.9s2.6-1.5 2.6-3.1-1.5-2.4-2.6-2.4" />
      <path d="M9.4 12c-2.4 0-3.9 1-3.9 2.6s1.5 2.6 3.1 2.6 2.4-1.5 2.4-2.6" />
    {%- when 'water_drop' -%}
      <path d="M12 3.2s6 6.1 6 10.1a6 6 0 0 1-12 0c0-4 6-10.1 6-10.1z" />
    {%- when 'fitness_center' -%}
      <path d="M3 9.5v5M6.5 7v10M17.5 7v10M21 9.5v5M6.5 12h11" />
    {%- when 'spa' -%}
      <path d="M12 20.5c0-6 3.6-11 8.5-12.5C20.5 14 17 19.5 12 20.5z" />
      <path d="M12 20.5C12 14.5 8.4 9.5 3.5 8c0 6 3.5 11.5 8.5 12.5z" />
    {%- when 'psychology' -%}
      <path d="M20 12.5a8 8 0 1 0-5 7.4v1.6h-6v-3.3l-2.6-1a1 1 0 0 1-.5-1.4l1-2" />
      <path d="M12.5 6.5v3.2l2 1.2" />
    {%- when 'brightness_5' -%}
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M5 5l1.7 1.7M17.3 17.3L19 19M19 5l-1.7 1.7M6.7 17.3L5 19" />
    {%- when 'grain' -%}
      <circle cx="7" cy="7" r="1.8" fill="currentColor" stroke="none" />
      <circle cx="14" cy="9" r="1.8" fill="currentColor" stroke="none" />
      <circle cx="8" cy="14.5" r="1.8" fill="currentColor" stroke="none" />
      <circle cx="16" cy="16" r="1.8" fill="currentColor" stroke="none" />
    {%- when 'sell' -%}
      <path d="M11.6 3.5H4.5a1 1 0 0 0-1 1v7.1a2 2 0 0 0 .6 1.4l7.4 7.4a2 2 0 0 0 2.8 0l6.1-6.1a2 2 0 0 0 0-2.8L13 4.1a2 2 0 0 0-1.4-.6z" />
      <circle cx="8" cy="8" r="1.4" fill="currentColor" stroke="none" />
    {%- when 'key' -%}
      <circle cx="8" cy="12" r="4.5" />
      <path d="M12.5 12H21M18 12v3.5M15.5 12v2.5" />
    {%- when 'mark_email_read' -%}
      <path d="M20.5 11.5V6.5a1.5 1.5 0 0 0-1.5-1.5H4.5A1.5 1.5 0 0 0 3 6.5v11A1.5 1.5 0 0 0 4.5 19h8" />
      <path d="M3.4 6.2l8.6 6 8.6-6" />
      <path d="M15.5 18.5l2 2 4-4.5" />
    {%- else -%}
      <circle cx="12" cy="12" r="8" />
  {%- endcase -%}
</svg>
